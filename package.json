{
  "name": "@lucrtrade/chartmint",
  "version": "0.0.10",
  "description": "Chartmint library.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucrtrade/chartmint.git"
  },
  "scripts": {
    "build": "tsup && tsgo -p tsconfig.build.json",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsgo --noEmit",
    "ci": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "prepublishOnly": "bun run ci && bun run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "lightweight-charts": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "lightweight-charts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/native-preview": "beta",
    "@types/node": "^26.1.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lightweight-charts": "^5.2.0",
    "lint-staged": "^17.0.2",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
